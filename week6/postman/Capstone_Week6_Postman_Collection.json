    {
      "name": "01 Get ADMIN token (run first)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login worked (200)', function () { pm.response.to.have.status(200); });",
              "var t = pm.response.json().access_token;",
              "pm.collectionVariables.set('admin_token', t);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "capstone-client",
              "type": "text"
            },
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "username",
              "value": "admin1",
              "type": "text"
            },
            {
              "key": "password",
              "value": "Admin@12345",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/realms/capstone/protocol/openid-connect/token",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "realms",
            "capstone",
            "protocol",
            "openid-connect",
            "token"
          ]
        }
      }
    },
    {
      "name": "02 Get USER token (run second)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login worked (200)', function () { pm.response.to.have.status(200); });",
              "var t = pm.response.json().access_token;",
              "pm.collectionVariables.set('user_token', t);",
              "try {",
              "  var p = t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
              "  var j = JSON.parse(atob(p));",
              "  pm.collectionVariables.set('candidate_user_id', j.sub);",
              "} catch (e) { console.log('could not read user id: ' + e); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "client_id",
              "value": "capstone-client",
              "type": "text"
            },
            {
              "key": "grant_type",
              "value": "password",
              "type": "text"
            },
            {
              "key": "username",
              "value": "candidate1",
              "type": "text"
            },
            {
              "key": "password",
              "value": "Candidate@12345",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:8080/realms/capstone/protocol/openid-connect/token",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "realms",
            "capstone",
            "protocol",
            "openid-connect",
            "token"
          ]
        }
      }
