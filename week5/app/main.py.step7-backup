KEYCLOAK_ISSUER = os.getenv(
    "KEYCLOAK_ISSUER",
    "http://localhost:8080/realms/capstone"
)

KEYCLOAK_JWKS_URL = os.getenv(
    "KEYCLOAK_JWKS_URL",
    "http://keycloak:8080/realms/capstone/protocol/openid-connect/certs"
)

security = HTTPBearer()
jwks_client = PyJWKClient(KEYCLOAK_JWKS_URL)


# =========================================================
# KEYCLOAK JWT VERIFICATION
# =========================================================

def verify_keycloak_token(
    credentials: HTTPAuthorizationCredentials = Depends(security)
):
    token = credentials.credentials

    try:
        signing_key = jwks_client.get_signing_key_from_jwt(token)

        payload = jwt.decode(
            token,
            signing_key.key,
            algorithms=["RS256"],
            options={
                "verify_exp": True,
                "verify_iss": False,
                "verify_aud": False
            }
        )

        
        return {
            "user_id": payload.get("sub"),
            "username": payload.get("preferred_username"),
            "name": payload.get("name"),
            "email": payload.get("email"),
            "roles": payload.get("realm_access", {}).get("roles", [])
        }


    except jwt.PyJWTError:
        raise HTTPException(
            status_code=401,
            detail="Invalid or expired Keycloak token"
        )
    except Exception:
        raise HTTPException(
            status_code=401,
            detail="Could not verify Keycloak token"
        )


# =========================================================
# ROLE-BASED ACCESS CONTROL
# =========================================================

def require_user_or_admin(
    user=Depends(verify_keycloak_token)
):
    roles = user.get("roles", [])

    if "admin" not in roles and "user" not in roles:
        raise HTTPException(
            status_code=403,
            detail="Access denied. Admin or user role required."
        )

    return user


def require_admin(
    user=Depends(verify_keycloak_token)
):
    roles = user.get("roles", [])

    if "admin" not in roles:
        raise HTTPException(
            status_code=403,
            detail="Access denied. Admin role required."
        )

    return user

def require_user(
    user=Depends(verify_keycloak_token)
):
    roles = user.get("roles", [])

    if "user" not in roles or "admin" in roles:
        raise HTTPException(
            status_code=403,
            detail="Access denied. User role required."
        )

    return user
# =========================================================
# MINIO CONFIGURATION
# =========================================================

DATABASE_URL = os.getenv("DATABASE_URL", "")

def db_connect():
    if not DATABASE_URL:
        raise RuntimeError("DATABASE_URL environment variable is not configured")
    return psycopg.connect(DATABASE_URL)


def register_candidate_owner(candidate_id: str, keycloak_user_id: str):
    with db_connect() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                INSERT INTO candidate_user_mapping (candidate_id, keycloak_user_id)
                VALUES (%s, %s)
                ON CONFLICT (candidate_id)
                DO UPDATE SET keycloak_user_id = EXCLUDED.keycloak_user_id
                WHERE candidate_user_mapping.keycloak_user_id = EXCLUDED.keycloak_user_id
                """,
                (candidate_id, keycloak_user_id),
            )
            if cur.rowcount != 1:
                raise ValueError("Candidate ID is already linked to another Keycloak user.")


def ensure_candidate_owner(candidate_id: str, keycloak_user_id: str):
    with db_connect() as conn:
        with conn.cursor() as cur:
            cur.execute(
                """
                SELECT 1 FROM candidate_user_mapping
                WHERE candidate_id = %s AND keycloak_user_id = %s
                """,
                (candidate_id, keycloak_user_id),
            )
            if cur.fetchone() is None:
                raise HTTPException(
                    status_code=403,
                    detail="You are not authorized to access this candidate's documents.",
                )


