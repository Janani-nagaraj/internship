ALLOWED_EXTENSIONS = {
    ".png", ".jpg", ".jpeg", ".bmp",
    ".tif", ".tiff", ".webp"
}

MAX_FILE_SIZE = 15 * 1024 * 1024

pytesseract.pytesseract.tesseract_cmd = os.getenv(
